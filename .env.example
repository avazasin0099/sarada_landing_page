# Copy to .env. Backend base URL INCLUDING the /api/v1 prefix, no trailing slash.
# The contact form POSTs to: ${VITE_API_BASE_URL}/contacts
VITE_API_BASE_URL=https://ebook-backend-production-df12ce62.up.railway.app/api/v1

# Avazas ebook app — used by the "কিনুন" (buy) modal.
# Deep link that opens the book inside the app; {id} is replaced with the note id (see src/data/site.ts).
# Leave empty to skip the "open in app" attempt and go straight to the install step.
VITE_APP_DEEP_LINK=avazasebook://books/{id}
# Where to get the app when it isn't installed: a direct .apk file URL or a store page.
VITE_APP_DOWNLOAD_URL=https://github.com/avazasin0099/sarada_landing_page/releases/download/app-v1.0.0/avazas-books.apk
# App icon shown in the buy modal (square image URL or /images/... path). Optional.
VITE_APP_ICON_URL=/images/avazas-icon.png
